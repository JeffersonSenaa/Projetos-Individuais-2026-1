LLM_PROVIDER=gemini # utilização do Gemini lite por conta de custos

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite

# OpenAI - aqui é necessário ajustar LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Database
# Dentro do Docker (api/worker/scheduler):
DATABASE_URL=postgresql://uda:uda_secret@postgres:5432/uda_habitacional
# Fora do Docker (CLI na máquina local) — descomente a linha abaixo:
# DATABASE_URL=postgresql://uda:uda_secret@localhost:5433/uda_habitacional
POSTGRES_HOST_PORT=5433 # Utilização da porta 5433 pois tinha outra aplicação em uso. Serve por padrão a porta 5432
REDIS_HOST_PORT=6380    # Utilizado essa porta por já ter outra aplicação em uso
POSTGRES_USER=uda
POSTGRES_PASSWORD=uda_secret
POSTGRES_DB=uda_habitacional

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage
PDF_STORAGE_PATH=/app/data/pdfs

# Scheduler (cron: hour minute)
SCAN_CRON_HOUR=6
SCAN_CRON_MINUTE=0

# API
API_HOST=0.0.0.0
API_PORT=8000
